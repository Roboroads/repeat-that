---
import { hasRoute, REPO_URL } from "../lib/docs";

const links = [
  { href: REPO_URL, label: "GitHub" },
  { href: "/security/", label: "Security" },
  ...(hasRoute("/code-signing/") ? [{ href: "/code-signing/", label: "Code signing" }] : []),
  { href: "/privacy/", label: "Privacy" },
];
---

<footer class="site-footer">
  <div class="wrap">
    <p>
      Repeat That is free software, licensed under the
      <a href={`${REPO_URL}/blob/main/LICENSE`}>GNU General Public License v3.0 or later</a>.
    </p>
    <nav aria-label="Footer">
      <ul>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
  </div>
</footer>
