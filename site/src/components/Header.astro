---
import appIcon from "../../../app/src-tauri/icons/svg/app.svg";
import { hasRoute, REPO_URL } from "../lib/docs";

const links = [
  { href: "/#downloads", label: "Download" },
  ...(hasRoute("/guide/") ? [{ href: "/guide/", label: "Guide" }] : []),
  { href: "/verify/", label: "Verify downloads" },
  { href: "/privacy/", label: "Privacy" },
  { href: REPO_URL, label: "GitHub" },
];
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <img src={appIcon.src} width="32" height="32" alt="" />
      <span>Repeat That</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
