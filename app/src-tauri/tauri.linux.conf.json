{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "enableGTKAppId": true
  },
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "icon": ["icons/32x32.png"],
    "homepage": "https://github.com/Roboroads/repeat-that",
    "longDescription": "Repeat That keeps the last few seconds of speech from one app you pick (Discord, Teams, a browser) in memory, without the silence, and replays the last thing that was said when you press a hotkey. The audio never touches the disk.",
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.38)",
          "libstdc++6 (>= 13)",
          "libpipewire-0.3-0t64 | libpipewire-0.3-0",
          "libasound2t64 | libasound2"
        ],
        "recommends": ["pipewire", "wireplumber"],
        "section": "sound",
        "desktopTemplate": "linux/hidden.desktop",
        "files": {
          "/usr/share/applications/me.roboroads.repeat-that.desktop": "linux/me.roboroads.repeat-that.desktop",
          "/usr/share/icons/hicolor/scalable/apps/me.roboroads.repeat-that.svg": "icons/svg/app.svg",
          "/usr/share/icons/hicolor/32x32/apps/me.roboroads.repeat-that.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/apps/me.roboroads.repeat-that.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/me.roboroads.repeat-that.png": "icons/128x128@2x.png",
          "/usr/share/icons/hicolor/512x512/apps/me.roboroads.repeat-that.png": "icons/icon.png",
          "/usr/share/pixmaps/me.roboroads.repeat-that.png": "icons/128x128.png"
        }
      },
      "rpm": {
        "depends": [
          "libc.so.6(GLIBC_2.38)(64bit)",
          "libstdc++.so.6(GLIBCXX_3.4.31)(64bit)",
          "libpipewire-0.3.so.0()(64bit)",
          "libasound.so.2()(64bit)"
        ],
        "recommends": ["pipewire", "wireplumber"],
        "desktopTemplate": "linux/hidden.desktop",
        "files": {
          "/usr/share/applications/me.roboroads.repeat-that.desktop": "linux/me.roboroads.repeat-that.desktop",
          "/usr/share/icons/hicolor/scalable/apps/me.roboroads.repeat-that.svg": "icons/svg/app.svg",
          "/usr/share/icons/hicolor/32x32/apps/me.roboroads.repeat-that.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/apps/me.roboroads.repeat-that.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/me.roboroads.repeat-that.png": "icons/128x128@2x.png",
          "/usr/share/icons/hicolor/512x512/apps/me.roboroads.repeat-that.png": "icons/icon.png",
          "/usr/share/pixmaps/me.roboroads.repeat-that.png": "icons/128x128.png"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/applications/Repeat That.desktop": "linux/me.roboroads.repeat-that.desktop",
          "/usr/share/icons/hicolor/scalable/apps/me.roboroads.repeat-that.svg": "icons/svg/app.svg",
          "/usr/share/icons/hicolor/32x32/apps/me.roboroads.repeat-that.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/apps/me.roboroads.repeat-that.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/me.roboroads.repeat-that.png": "icons/128x128@2x.png",
          "/usr/share/icons/hicolor/512x512/apps/me.roboroads.repeat-that.png": "icons/icon.png"
        }
      }
    }
  }
}
